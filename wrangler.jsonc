{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyvault",
  "main": ".open-next/worker.js",
  // Keep plain-text variables that were added in the dashboard (e.g. NEXT_PUBLIC_SUPABASE_*),
  // otherwise every `wrangler deploy` from this config deletes them.
  "keep_vars": true,
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "notes.sidcandev.online",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "studyvault"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STUDYVAULT_BUCKET",
      "bucket_name": "studyvault"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "studyvault-opennext-cache"
    }
  ]
}
